---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { site, adsense, analytics } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** Imagem de compartilhamento (URL absoluta). Padrão: logo do site. */
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, ogType = 'website', ogImage, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const image = ogImage ?? `${site.url}/favicon-512x512.png`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1e3a5f" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      adsense.client && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.client}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      analytics.ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4Id}`} />
          <script is:inline define:vars={{ id: analytics.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id);
            // Cliques nos blocos de leitura relacionada (data-clic="nome-do-bloco").
            document.addEventListener('click', (e) => {
              const link = e.target instanceof Element && e.target.closest('a[data-clic]');
              if (link) gtag('event', 'clic_relacionado', { bloque: link.dataset.clic, destino: link.getAttribute('href') });
            });
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <StickyBar />
  </body>
</html>
