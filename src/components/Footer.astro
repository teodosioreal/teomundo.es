---
import { site, footerLinks, footerNotice } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line bg-soft">
  <div class="container-page py-10 text-sm leading-relaxed text-muted">
    <p class="font-serif text-lg font-bold text-brand-900">{site.name}</p>
    <p class="mt-1 max-w-prose">{site.description}</p>
    <nav aria-label="Información del sitio" class="mt-6">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href} class="font-medium text-brand-900 hover:text-brand-700">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {footerNotice && <p class="mt-6 max-w-3xl"><strong>Aviso:</strong> {footerNotice}</p>}
    <p class="mt-8">&copy; {year} {site.name}. Todos los derechos reservados.</p>
  </div>
</footer>
