---
// Comentários dos artigos. Os dados ficam no Cloudflare D1 (functions/api/comentarios.js)
// e cada comentário só aparece depois de aprovado em /moderar.
import { comments } from '../data/site';

interface Props {
  /** "<categoria>/<slug>" do artigo. */
  path: string;
}
const { path } = Astro.props;
---

{
  comments.active && (
    <section class="mt-12" aria-labelledby="comentarios-title" data-comments={path}>
      <h2 id="comentarios-title" class="mb-4 text-2xl font-bold">
        Comentarios
      </h2>
      <ol class="comments-list space-y-4" aria-live="polite"></ol>
      <p class="comments-empty text-base text-muted">Todavía no hay comentarios. ¿Te animas a dejar el primero?</p>

      <form class="comments-form mt-6 space-y-4 rounded-xl border border-line bg-soft p-5" novalidate>
        <p class="font-semibold text-ink">Deja tu comentario</p>
        <div>
          <label for="c-name" class="block text-sm font-semibold">Nombre</label>
          <input id="c-name" name="name" required minlength="2" maxlength="60" autocomplete="name" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
        </div>
        <div>
          <label for="c-body" class="block text-sm font-semibold">Comentario</label>
          <textarea id="c-body" name="body" required minlength="3" maxlength="2000" rows="4" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
        </div>
        <div class="hidden" aria-hidden="true">
          <label for="c-website">No rellenes este campo</label>
          <input id="c-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <label class="flex items-start gap-2 text-sm">
          <input type="checkbox" name="privacy" required class="mt-1" />
          <span>
            He leído la <a href="/politica-de-privacidad/">política de privacidad</a> y acepto que se guarden mi nombre y mi
            comentario para publicarlo.
          </span>
        </label>
        <p class="text-sm text-muted">Revisamos cada comentario antes de publicarlo. No compartas datos personales ni de salud.</p>
        <button type="submit" class="rounded-lg bg-brand-700 px-5 py-3 font-semibold text-white hover:bg-brand-900">Enviar comentario</button>
        <p class="comments-status text-base font-semibold" role="status"></p>
      </form>
    </section>
  )
}

<script>
  const fmt = (iso: string) =>
    new Date(iso).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

  for (const section of document.querySelectorAll<HTMLElement>('[data-comments]')) {
    const path = section.dataset.comments!;
    const list = section.querySelector('.comments-list')!;
    const empty = section.querySelector<HTMLElement>('.comments-empty')!;
    const form = section.querySelector<HTMLFormElement>('.comments-form')!;
    const status = section.querySelector<HTMLElement>('.comments-status')!;

    fetch(`/api/comentarios?slug=${encodeURIComponent(path)}`)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then(({ comments }: { comments: { name: string; body: string; created_at: string }[] }) => {
        if (!comments.length) return;
        empty.hidden = true;
        for (const c of comments) {
          const li = document.createElement('li');
          li.className = 'rounded-xl border border-line p-4';
          const head = document.createElement('p');
          head.className = 'text-sm text-muted';
          const name = document.createElement('strong');
          name.className = 'text-ink';
          name.textContent = c.name;
          head.append(name, ` · ${fmt(c.created_at)}`);
          const body = document.createElement('p');
          body.className = 'mt-2 whitespace-pre-line text-base';
          body.textContent = c.body;
          li.append(head, body);
          list.append(li);
        }
      })
      .catch(() => {
        empty.textContent = 'Los comentarios no están disponibles en este momento.';
      });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      status.textContent = 'Enviando…';
      const res = await fetch('/api/comentarios', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slug: path,
          name: data.get('name'),
          body: data.get('body'),
          website: data.get('website'),
          privacy: data.get('privacy') === 'on',
        }),
      }).catch(() => null);
      if (res && res.status === 202) {
        form.reset();
        status.textContent = '¡Gracias! Tu comentario aparecerá cuando lo revisemos.';
      } else if (res && res.status === 429) {
        status.textContent = 'Has enviado varios comentarios seguidos. Prueba de nuevo en unos minutos.';
      } else {
        status.textContent = 'No hemos podido enviar tu comentario. Revisa los campos e inténtalo de nuevo.';
      }
    });
  }
</script>
