---
import { site, categories } from '../data/site';
import { getPublishedArticles } from '../lib/articles';

// Só aparecem no menu as categorias que já têm artigo publicado.
const published = await getPublishedArticles();
const nav = [
  ...Object.entries(categories)
    .filter(([slug]) => published.some((a) => a.data.category === slug))
    .map(([slug, c]) => ({ label: c.name, href: `/${slug}/` })),
  { label: 'Sobre nosotros', href: '/sobre-nosotros/' },
];
---

<header class="relative border-b border-line bg-paper">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-paper focus:px-3 focus:py-2"
    >Saltar al contenido</a
  >
  <div class="container-page flex items-center justify-between gap-x-6 py-4">
    <a href="/" class="flex items-center gap-2 no-underline" aria-label={`${site.name}, inicio`}>
      <img src="/favicon.svg" width="36" height="36" alt="" />
      <span class="font-serif text-xl font-bold text-brand-900">Teo<span class="text-accent">Mundo</span></span>
    </a>
    <!-- Escritorio: menu em linha -->
    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-base">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="font-medium text-ink no-underline hover:text-brand-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <!-- Móvil: botão ☰ que abre o menu (sem JavaScript, com <details>) -->
    <details class="menu-movil md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md border border-line text-ink"
        aria-label="Abrir menú"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="icono-abrir" d="M4 7h16M4 12h16M4 17h16" />
          <path class="icono-cerrar" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </summary>
      <nav aria-label="Principal (móvil)" class="absolute inset-x-0 top-full z-40 border-b border-line bg-paper shadow-sm">
        <ul class="container-page divide-y divide-line py-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block py-3 text-lg font-medium text-ink no-underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
