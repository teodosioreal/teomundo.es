---
// Assinatura no fim de cada artigo: avatar da equipe, bio e links.
import { author, social } from '../data/site';

const links = [
  social.instagram && { label: 'Instagram', href: social.instagram },
  social.facebook && { label: 'Facebook', href: social.facebook },
].filter(Boolean) as { label: string; href: string }[];
---

<aside class="mt-12 flex gap-4 rounded-xl border border-line bg-soft p-5 sm:gap-5" aria-label="Sobre el autor">
  <img src={author.image} width="64" height="64" alt="" class="h-16 w-16 shrink-0" loading="lazy" />
  <div class="text-base leading-relaxed">
    <p class="text-sm text-muted">Escrito y revisado por</p>
    <p class="font-serif text-lg font-bold text-brand-900">
      <a href={author.url} class="text-brand-900 no-underline hover:text-brand-700">{author.name}</a>
    </p>
    <p class="mt-1 text-muted">{author.bio}</p>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a href={author.url}>Conoce al equipo</a>
      <a href="/politica-editorial/">Cómo trabajamos</a>
      {
        links.map((l) => (
          <a href={l.href} rel="noopener" target="_blank">
            {l.label}
          </a>
        ))
      }
    </p>
  </div>
</aside>
